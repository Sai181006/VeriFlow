schema Student {
    name: text;
    marks: int;
}

pipeline OptimizedStudents from "students.csv" as Student {
    require marks >= 0 and marks <= 100 else "marks must be between 0 and 100";
    let adjusted = (marks + 2 * 3) * 1 + 0;
    keep where true and adjusted >= 50;
    select name, adjusted;
    emit "optimized_students.csv";
}
